# Copy to ~/.config/vaultwarden/vaultwarden.env (chmod 600).
DATA_FOLDER=/home/YOU/.local/share/vaultwarden
# Local only; clients reach it through `tailscale serve` (HTTPS, tailnet only).
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8222
# The HTTPS address clients use, e.g. what `tailscale serve` prints.
DOMAIN=https://my-server.my-tailnet.ts.net
# Needs the vaultwarden-web package; set to true once it is installed.
WEB_VAULT_FOLDER=/usr/share/webapps/vaultwarden-web
WEB_VAULT_ENABLED=false
# Open only until the owner account exists, then set to false and restart.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
# No ADMIN_TOKEN: the /admin panel stays disabled.
LOG_LEVEL=warn
