[
  { "action": { "type": "setTheme", "theme": "light" } },
  { "wait": 5000 },
  { "evalMain": "document.querySelectorAll('.sidebar header .sidebar-toggle')[1].click(), 'clicked'" },
  { "wait": 900 },
  { "type": { "text": "test-np" } },
  { "wait": 300 },
  { "capture": "np-0-new" },
  { "evalMain": "document.querySelectorAll('.np-seg button')[1].click(), 'import tab'" },
  { "wait": 400 },
  { "evalMain": "'rows: ' + document.querySelectorAll('.np-row').length + ', imported: ' + document.querySelectorAll('.np-row.muted').length + ', hosts: ' + [...document.querySelectorAll('.np-chip')].map(c => c.textContent).join('/')" },
  { "evalMain": "(document.querySelector('.np-row:not(.muted)') || {click(){}}).click(), 'picked'" },
  { "wait": 300 },
  { "capture": "np-0-import" },
  { "evalMain": "document.querySelector('.np-btn.primary').click(), 'next'" },
  { "wait": 400 },
  { "evalMain": "'step2 title: ' + document.querySelector('.np-title').textContent + ', code: ' + [...document.querySelectorAll('.np-chip.on')].map(c => c.textContent).join() + ', path: ' + document.querySelector('.np-field input').value" },
  { "capture": "np-1-code" },
  { "evalMain": "document.querySelector('.np-btn.primary').click(), 'next'" },
  { "wait": 400 },
  { "evalMain": "'step3 host: ' + [...document.querySelectorAll('.np-chip.on')].map(c => c.textContent).join() + ', dir: ' + document.querySelector('.np-field input').value + ', button: ' + document.querySelector('.np-btn.primary').textContent" },
  { "capture": "np-2-term" },
  { "evalMain": "document.querySelector('.np-backdrop').dispatchEvent(new MouseEvent('mousedown', {bubbles: true})), 'closed'" },
  { "wait": 500 },
  { "evalMain": "'dialog gone: ' + !document.querySelector('.np') + ', archive button: ' + (document.querySelector('.archive-toggle') || {}).textContent" },
  { "evalMain": "(document.querySelector('.archive-toggle') || {click(){}}).click(), 'archive'" },
  { "wait": 400 },
  { "capture": "np-archive" }
]
