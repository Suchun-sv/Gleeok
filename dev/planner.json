 {"evalMain":"(async()=>{const P=(op)=>gleeok.planner(op).then(r=>{if(r.error)throw new Error(r.error);return r.result});const d=new Date();const day=(n)=>{const x=new Date(d.getFullYear(),d.getMonth(),d.getDate()+n);return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0')};const at=(n,h,m)=>new Date(d.getFullYear(),d.getMonth(),d.getDate()+n,h,m).toISOString();const ts=await P({op:'create',kind:'tasks',objects:[{title:'改 DS4D 讲义第 3 节',due:day(0),priority:3,estimate:3,projectId:window.__pid,order:1,subtasks:[{id:'a',title:'画图',done:true},{id:'b',title:'写例子',done:false}]},{title:'读 RAG 论文',due:day(1),priority:2,estimate:2,order:2},{title:'回导师邮件',due:day(-1),priority:1,order:3},{title:'跑 KV cache 实验',order:4,estimate:4},{title:'组会准备',due:day(2)+'T14:00',order:5,projectId:window.__pid}]});window.__tasks=ts;await P({op:'create',kind:'blocks',objects:[{taskKey:ts[0].key,start:at(0,9,0),end:at(0,10,15)},{taskKey:ts[1].key,start:at(1,10,0),end:at(1,11,0)},{title:'午饭',start:at(0,12,0),end:at(0,13,0)},{taskKey:ts[3].key,start:at(0,9,30),end:at(0,11,0)}]});return 'seeded '+ts.length})()"},
