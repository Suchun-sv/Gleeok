{
  "name": "gleeok",
  "version": "0.1.0",
  "private": true,
  "description": "Per-project browser workspace",
  "main": "boot.js",
  "scripts": {
    "build": "node build.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p .",
    "dist:mac": "npm run build && MAC_SIGN_IDENTITY=\"${MAC_SIGN_IDENTITY:-Gleeok Self-Signed}\" electron-builder --mac dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "https://github.com/castlabs/electron-releases/archive/refs/tags/v44.9.3%2Bwvcus.tar.gz",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.gleeok.app",
    "productName": "Gleeok",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "boot.js",
      "dist/**",
      "assets/**",
      "vendor/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "Utility",
      "executableName": "gleeok"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "extendInfo": {
        "NSLocationUsageDescription": "Gleeok 用你的位置显示当地的天气。",
        "NSLocationWhenInUseUsageDescription": "Gleeok 用你的位置显示当地的天气。"
      }
    },
    "afterPack": "build-hooks/vmp-sign.cjs",
    "asar": false,
    "artifactName": "Gleeok-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Gleeok-${version}-windows-${arch}-setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Suchun-sv",
        "repo": "Gleeok",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false,
    "core-js": false,
    "node-pty": true
  },
  "dependencies": {
    "@bitwarden/cli": "^2026.10.0",
    "@getpaseo/client": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "hono": "^4.13.13",
    "node-pty": "^1.1.0"
  },
  "license": "AGPL-3.0-only"
}
