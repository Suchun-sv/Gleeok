{
  "name": "gleeok",
  "version": "0.1.0",
  "private": true,
  "description": "Per-project browser workspace",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p .",
    "dist:mac": "npm run build && electron-builder --mac dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.gleeok.app",
    "productName": "Gleeok",
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon-512.png"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "Gleeok Self-Signed",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    }
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false,
    "core-js": false
  },
  "dependencies": {
    "@bitwarden/cli": "^2026.10.0",
    "@getpaseo/client": "^0.12.0",
    "hono": "^4.13.13"
  },
  "license": "Apache-2.0"
}
